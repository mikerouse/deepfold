# Copy to .env in the repo root (Compose) and/or apps/api/.env

# Postgres (docker compose default)
DATABASE_URL=postgresql+psycopg://deepfold:deepfold@localhost:5432/deepfold

# Local agent / VS Code fallback without Docker:
# DATABASE_URL=sqlite+pysqlite:///./apps/api/deepfold.db

REDIS_URL=redis://localhost:6379/0

# Feature flags — Approve & publish is OFF by default
APPROVE_AND_PUBLISH_ENABLED=false

# Hard kill switch: blocks CMS draft creation and any publish path
KILL_SWITCH=false

# Instantly complete Go jobs from seeded copy. Default off — jobs stay queued for Grok Bot.
DEMO_INSTANT_FULFILL=false

# Localhost stand-in for Grok Bot: claims/completes queued jobs with stub/seed copy after ~3s.
# Not an LLM call. Labelled “Simulating Grok Bot” on the desk. Also enables POST /jobs/demo-tick.
DEMO_GROK_WORKER=false
# DEMO_GROK_WORKER_DELAY_SECONDS=3

# Journalist identity recorded on decisions (no auth in v0)
DEFAULT_ACTOR=journalist@newsworld.local

# Publisher chrome (Conservative Post is one title, not this name)
PUBLISHER_NAME=Newsworld

# WordPress Application Password flow (draft-only unless flag + kill switch allow publish)
WP_LIVE=false
WP_USERNAME=
WP_APPLICATION_PASSWORD=

# Desk
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
